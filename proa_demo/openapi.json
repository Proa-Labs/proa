{
  "openapi": "3.1.0",
  "info": {
    "title": "Proa Playground API",
    "version": "1.0.0",
    "description": "API for the Proa SSR Playground — render Airbnb and Nike showcase pages with custom props, run load tests, and compare rendering performance across engines (Proa/Rust, React/Node, React/Bun)."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/render": {
      "post": {
        "summary": "Render a page with optional props",
        "operationId": "renderPage",
        "tags": [
          "Rendering"
        ],
        "description": "Renders the specified showcase page using the Proa SSR engine. Returns raw HTML with timing metadata in response headers. If `props` is omitted, default showcase props are used.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rendered HTML page",
            "headers": {
              "x-render-us": {
                "description": "Pure SSR render time in microseconds (minimum of 10 iterations)",
                "schema": {
                  "type": "string"
                }
              },
              "x-deser-us": {
                "description": "JSON deserialization time in microseconds",
                "schema": {
                  "type": "string"
                }
              },
              "x-e2e-us": {
                "description": "Total server-side handler time in microseconds",
                "schema": {
                  "type": "string"
                }
              },
              "x-html-size": {
                "description": "HTML response size in bytes",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (unknown page or malformed props)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/loadtest": {
      "post": {
        "summary": "Run a load test across all engines",
        "operationId": "loadTest",
        "tags": [
          "Benchmarking"
        ],
        "description": "Runs concurrent render requests against Proa (Rust), React/Node, and React/Bun engines, returning latency statistics for each.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoadTestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Load test results for all engines",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoadTestResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/props": {
      "get": {
        "summary": "Get default showcase props for all pages",
        "operationId": "getDefaultProps",
        "tags": [
          "Rendering"
        ],
        "description": "Returns the full default props JSON for every showcase page. This is the same data used when `props` is omitted from a render request.",
        "responses": {
          "200": {
            "description": "Default props keyed by page name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllPageProps"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "engine"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "engine": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "PageName": {
        "type": "string",
        "enum": [
          "home",
          "search",
          "listing",
          "nike-catalog",
          "nike-pdp"
        ],
        "description": "Available showcase pages"
      },
      "RenderRequest": {
        "type": "object",
        "required": [
          "page"
        ],
        "properties": {
          "page": {
            "$ref": "#/components/schemas/PageName"
          },
          "props": {
            "description": "Page-specific props object. Schema depends on the `page` value. If omitted, default showcase props are used.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/HomeProps"
              },
              {
                "$ref": "#/components/schemas/SearchProps"
              },
              {
                "$ref": "#/components/schemas/ListingProps"
              },
              {
                "$ref": "#/components/schemas/NikeCatalogProps"
              },
              {
                "$ref": "#/components/schemas/NikePdpProps"
              }
            ]
          }
        }
      },
      "LoadTestRequest": {
        "type": "object",
        "required": [
          "page"
        ],
        "properties": {
          "page": {
            "$ref": "#/components/schemas/PageName"
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "default": 10,
            "description": "Number of concurrent requests"
          },
          "iterations": {
            "type": "integer",
            "minimum": 1,
            "default": 100,
            "description": "Total number of render requests"
          },
          "port": {
            "type": "integer",
            "description": "Override port for the Node/Bun companion servers"
          }
        }
      },
      "LatencyStats": {
        "type": "object",
        "required": [
          "avg",
          "p50",
          "p99",
          "min",
          "max"
        ],
        "properties": {
          "avg": {
            "type": "number",
            "description": "Mean latency in microseconds"
          },
          "p50": {
            "type": "number",
            "description": "Median latency in microseconds"
          },
          "p99": {
            "type": "number",
            "description": "99th percentile latency in microseconds"
          },
          "min": {
            "type": "number",
            "description": "Minimum latency in microseconds"
          },
          "max": {
            "type": "number",
            "description": "Maximum latency in microseconds"
          }
        }
      },
      "EngineResult": {
        "type": "object",
        "required": [
          "total_requests",
          "failed_requests",
          "duration_ms",
          "rps",
          "ssr_us",
          "roundtrip_us"
        ],
        "properties": {
          "total_requests": {
            "type": "integer"
          },
          "failed_requests": {
            "type": "integer"
          },
          "duration_ms": {
            "type": "number",
            "description": "Total wall-clock duration in milliseconds"
          },
          "rps": {
            "type": "number",
            "description": "Requests per second"
          },
          "ssr_us": {
            "$ref": "#/components/schemas/LatencyStats",
            "description": "Pure SSR render time (template to bytes, no HTTP overhead)"
          },
          "roundtrip_us": {
            "$ref": "#/components/schemas/LatencyStats",
            "description": "Full HTTP roundtrip latency"
          }
        }
      },
      "LoadTestResult": {
        "type": "object",
        "required": [
          "proa",
          "react",
          "bun"
        ],
        "properties": {
          "proa": {
            "$ref": "#/components/schemas/EngineResult"
          },
          "react": {
            "$ref": "#/components/schemas/EngineResult"
          },
          "bun": {
            "$ref": "#/components/schemas/EngineResult"
          }
        }
      },
      "AllPageProps": {
        "type": "object",
        "properties": {
          "home": {
            "$ref": "#/components/schemas/HomeProps"
          },
          "search": {
            "$ref": "#/components/schemas/SearchProps"
          },
          "listing": {
            "$ref": "#/components/schemas/ListingProps"
          },
          "nike-catalog": {
            "$ref": "#/components/schemas/NikeCatalogProps"
          },
          "nike-pdp": {
            "$ref": "#/components/schemas/NikePdpProps"
          }
        }
      },
      "HomeListing": {
        "type": "object",
        "required": [
          "title",
          "location",
          "price_per_night",
          "rating",
          "property_type",
          "image"
