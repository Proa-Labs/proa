{
  "name": "proa-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "editor:test": "pnpm -C editors/lsp test && pnpm -C editors/vscode test",
    "editor:test:neovim": "pnpm -C editors/lsp run test:neovim",
    "react:csp-smoke": "node scripts/react-csp-smoke.mjs",
    "react:csp-smoke:headed": "node scripts/react-csp-smoke.mjs --debug",
    "stream:boundary-smoke": "node scripts/stream-boundary-framing-smoke.mjs",
    "search:vendor": "node scripts/vendor_orama.mjs",
    "search:battery": "node scripts/search_battery.mjs"
  },
  "dependencies": {
    "playwright": "1.61.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@orama/orama": "3.1.18",
    "@orama/stemmers": "3.1.18",
    "esbuild": "0.28.2"
  }
}
