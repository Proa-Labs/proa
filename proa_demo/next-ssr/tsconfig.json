{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@lib/*": [
        "./lib/*"
      ],
      "@shared/*": [
        "../react-ssr-shared/src/*"
      ],
      "@react-ssr/*": [
        "../react-ssr/*"
      ],
      "react": [
        "./node_modules/react"
      ],
      "react/*": [
        "./node_modules/react/*"
      ],
      "react-dom": [
        "./node_modules/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/react-dom/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../react-ssr/page.tsx",
    "../react-ssr-shared/src/**/*.ts",
    "../react-ssr-shared/src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
