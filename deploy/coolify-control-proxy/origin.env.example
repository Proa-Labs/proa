PREVIEW=coolify
FQDN=coolify.proa.cool
PORT=8000
HEALTH_PATH=/api/health
REALTIME_PORT=6001
TERMINAL_PORT=6002
AUTH_HEADER_FILE=/etc/haproxy/coolify-origin.token
REDIRECT_HOST=coolify.proa.so
# No path is public on the origin. The Cloudflare Worker validates GitHub's
# signature and adds the origin credential before forwarding webhooks.
PUBLIC_PATH=
# Exact Worker-to-host archive transition path. HAProxy requires the existing
# origin credential before routing this path to the loopback-only controller;
# the controller independently verifies ARCHIVE_CONTROL_SECRET HMAC headers.
ARCHIVE_CONTROL_PATH=/_proa/origin/preview-archive
ARCHIVE_CONTROL_PORT=8788
# Exact immutable links bypass Coolify's shared Traefik providers entirely.
# HAProxy accepts only proa-marketing-<12 lowercase alphanumeric>.proa.cool
# for this backend and sends it to the dedicated internal archive router.
ARCHIVE_ROUTER_APPLICATION=proa-marketing
ARCHIVE_ROUTER_DOMAIN=proa.cool
ARCHIVE_ROUTER_HOST=172.31.252.2
ARCHIVE_ROUTER_PORT=8082
ARCHIVE_ROUTER_HEALTH_PORT=8083
# Send all remaining dynamic pr-N.proa.cool hosts through HAProxy to Coolify's
# loopback Traefik listener. Per-PR HAProxy entries bypass Coolify and are
# forbidden. The exact archive ACL is emitted before this broad route.
ROUTER_SUFFIX=proa.cool
ROUTER_PORT=8081
