        ],
        "properties": {
          "cleanliness": {
            "type": "string"
          },
          "accuracy": {
            "type": "string"
          },
          "check_in": {
            "type": "string"
          },
          "communication": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "ListingReview": {
        "type": "object",
        "required": [
          "name",
