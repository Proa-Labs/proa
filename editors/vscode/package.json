{
  "name": "proa",
  "displayName": "Proa",
  "description": "Proa editor support, including Rust highlighting and navigation inside Markdown templates using your existing rust-analyzer.",
  "publisher": "proa-labs",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Proa-Labs/proa.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onLanguage:rust"
  ],
  "extensionDependencies": [
    "rust-lang.rust-analyzer"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "configuration": {
      "title": "Proa",
      "properties": {
        "proa.lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show live Proa lint diagnostics for unsaved Rust buffers and their counterpart views. Requires an updated Proa CLI."
        },
        "proa.lint.path": {
          "type": "string",
          "default": "proa",
          "scope": "machine-overridable",
          "description": "Path to the Proa executable used for live linting."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "test": "node scripts/sync-core.mjs && node --test test/*.test.mjs",
    "test:live": "node scripts/sync-core.mjs && node test/run-live-lint.mjs",
    "prepare": "node scripts/sync-core.mjs",
    "vscode:prepublish": "node scripts/sync-core.mjs"
  },
  "files": [
    "extension.cjs",
    "src",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@9.15.2"
}
