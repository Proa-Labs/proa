[Unit]
Description=Isolated router for immutable Proa preview archives
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/etc/proa/preview-archive.env
ConditionPathExists=/etc/proa/preview-archive-router.image
ConditionPathExists=/etc/proa/preview-archive-router-static.yml
ConditionPathIsDirectory=/var/lib/proa-preview-archive/routes
OnFailure=proa-preview-archive-alert@%n.service

[Service]
Type=simple
Environment=PROA_ARCHIVE_CONFIG_FILE=/etc/proa/preview-archive.env
Environment=DOCKER_CONFIG=/run/proa-preview-archive-router
ExecStartPre=/usr/local/sbin/proa-preview-archive-router prepare
ExecStart=/usr/local/sbin/proa-preview-archive-router run
ExecStartPost=/usr/local/sbin/proa-preview-archive-router attest
ExecStop=/usr/local/sbin/proa-preview-archive-router stop
ExecStopPost=-/usr/local/sbin/proa-preview-archive-router prepare
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=20s
UMask=0077
RuntimeDirectory=proa-preview-archive-router
RuntimeDirectoryMode=0700
User=root
Group=root
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadOnlyPaths=/etc/proa/preview-archive.env
ReadOnlyPaths=/etc/proa/preview-archive-router.image
ReadOnlyPaths=/etc/proa/preview-archive-router-static.yml
ReadOnlyPaths=/var/lib/proa-preview-archive/routes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
LimitNOFILE=256
TasksMax=32
MemoryMax=96M

[Install]
WantedBy=multi-user.target
